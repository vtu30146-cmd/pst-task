class UndergroundSystem {

    static class Pair {
        int time;
        String station;

        Pair(int time, String station) {
            this.time = time;
            this.station = station;
        }
    }

    // Stores the check-in information for each passenger.
    // id -> (check-in time, check-in station)
    HashMap<Integer, Pair> inOutTracker;

    // Stores all travel times for each station pair.
    // "start-end" -> list of travel times
    HashMap<String, ArrayList<Integer>> AtTracker;

    public UndergroundSystem() {
        inOutTracker = new HashMap<>();
        AtTracker = new HashMap<>();
    }

    public void checkIn(int id, String stationName, int t) {
        inOutTracker.put(id, new Pair(t, stationName));
    }

    public void checkOut(int id, String stationName, int t) {

        // Get the passenger's check-in information.
        Pair tmp = inOutTracker.get(id);

        // Create a unique key for the route.
        String key = tmp.station + "-" + stationName;

        // Create the list if this route is seen for the first time.
        if (!AtTracker.containsKey(key)) {
            AtTracker.put(key, new ArrayList<>());
        }

        // Store the travel time.
        AtTracker.get(key).add(t - tmp.time);
    }

    public double getAverageTime(String startStation, String endStation) {

        String key = startStation + "-" + endStation;

        double totalTime = 0;
        int count = 0;

        // Calculate the average travel time for this route.
        for (int time : AtTracker.get(key)) {
            totalTime += time;
            count++;
        }

        return totalTime / count;
    }
}

