import java.util.*;

class Solution {

    public String[] sortPeople(
            String[] names,
            int[] heights) {

        Integer[] indexes =
            new Integer[names.length];

        for (int i = 0; i < names.length; i++) {
            indexes[i] = i;
        }

        Arrays.sort(
            indexes,
            (a, b) ->
                Integer.compare(
                    heights[b],
                    heights[a]
                )
        );

        String[] result =
            new String[names.length];

        for (int i = 0; i < names.length; i++) {

            result[i] =
                names[indexes[i]];
        }

        return result;
    }
}
