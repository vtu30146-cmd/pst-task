import java.io.*;
import java.util.*;

public class Solution {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {

        int m = matrix.size();
        int n = matrix.get(0).size();

        int layers = Math.min(m, n) / 2;

        for (int layer = 0; layer < layers; layer++) {

            int top = layer;
            int left = layer;
            int bottom = m - 1 - layer;
            int right = n - 1 - layer;

            // Number of elements in this layer
            int size = 2 * (bottom - top + right - left);

            int[] elements = new int[size];

            int index = 0;

            // Top row: left to right
            for (int j = left; j <= right; j++) {
                elements[index] = matrix.get(top).get(j);
                index++;
            }

            // Right column: top to bottom
            for (int i = top + 1; i <= bottom; i++) {
                elements[index] = matrix.get(i).get(right);
                index++;
            }

            // Bottom row: right to left
            for (int j = right - 1; j >= left; j--) {
                elements[index] = matrix.get(bottom).get(j);
                index++;
            }

            // Left column: bottom to top
            for (int i = bottom - 1; i > top; i--) {
                elements[index] = matrix.get(i).get(left);
                index++;
            }

            // Anti-clockwise rotation
            int rotation = r % size;

            int[] rotated = new int[size];

            for (int i = 0; i < size; i++) {
                rotated[i] = elements[(i + rotation) % size];
            }

            index = 0;

            // Put rotated values back

            // Top row
            for (int j = left; j <= right; j++) {
                matrix.get(top).set(j, rotated[index]);
                index++;
            }

            // Right column
            for (int i = top + 1; i <= bottom; i++) {
                matrix.get(i).set(right, rotated[index]);
                index++;
            }

            // Bottom row
            for (int j = right - 1; j >= left; j--) {
                matrix.get(bottom).set(j, rotated[index]);
                index++;
            }

            // Left column
            for (int i = bottom - 1; i > top; i--) {
                matrix.get(i).set(left, rotated[index]);
                index++;
            }
        }

        // Print the final matrix
        for (int i = 0; i < m; i++) {

            for (int j = 0; j < n; j++) {

                System.out.print(matrix.get(i).get(j));

                if (j < n - 1) {
                    System.out.print(" ");
                }
            }

            System.out.println();
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Read rows, columns and rotations
        int m = sc.nextInt();
        int n = sc.nextInt();
        int r = sc.nextInt();

        List<List<Integer>> matrix = new ArrayList<List<Integer>>();

        // Read matrix
        for (int i = 0; i < m; i++) {

            List<Integer> row = new ArrayList<Integer>();

            for (int j = 0; j < n; j++) {
                row.add(sc.nextInt());
            }

            matrix.add(row);
        }

        // Rotate matrix
        matrixRotation(matrix, r);

        sc.close();
    }
}
